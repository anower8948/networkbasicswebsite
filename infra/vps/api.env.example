# ---------------------------------------------------------------------------
# /etc/nlp/api.env — production configuration for the API service.
#
#   sudo install -m 0640 -o root -g nlp api.env.example /etc/nlp/api.env
#   sudo -e /etc/nlp/api.env
#
# Mode 0640 root:nlp: the service can read it, other users on the box cannot.
# Every value below is checked at start-up — the process refuses to boot if any
# of them is left at a development setting. See `app/core/config.py`.
# ---------------------------------------------------------------------------

ENVIRONMENT=production
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing this signs every existing session out.
SECRET_KEY=CHANGE_ME

DATABASE_URL=postgresql+asyncpg://nlp:CHANGE_ME@127.0.0.1:5432/network_learning

# The address the browser reaches. Used to build emailed links, so it must be
# the public hostname and must be https.
FRONTEND_URL=https://learn.example.com
CORS_ORIGINS=https://learn.example.com
ALLOWED_HOSTS=learn.example.com

REFRESH_COOKIE_SECURE=true
HSTS_ENABLED=true
RATE_LIMIT_ENABLED=true

# Turn off once the real administrator account exists — otherwise the next
# person to register on an empty instance becomes an admin.
BOOTSTRAP_FIRST_USER_AS_ADMIN=false

EMAIL_BACKEND=smtp
EMAIL_FROM=Network Learning Platform <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=true

# Roughly 2×cores. Raise only with evidence from the response-time logs.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
