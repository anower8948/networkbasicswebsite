# ---------------------------------------------------------------------------
# Network Learning Platform — backend configuration
# Copy to `.env` for local development. Never commit the real `.env`.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=true

# REQUIRED in staging/production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Omitting it in development generates an ephemeral key, which invalidates every
# token whenever the server restarts.
SECRET_KEY=

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Development: SQLite. Production: PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./network_learning.db
# DATABASE_URL=postgresql+asyncpg://nlp:password@localhost:5432/network_learning
DB_ECHO=false

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Must be true in production (requires HTTPS).
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Promotes the first registered account to administrator. Turn off once the
# real administrator account exists.
BOOTSTRAP_FIRST_USER_AS_ADMIN=true

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# "console" logs the message (including the verification/reset link) instead of
# sending it — the development default, so no SMTP server is needed to click
# through either flow. Use "smtp" in staging and production.
EMAIL_BACKEND=console
EMAIL_FROM=Network Learning Platform <no-reply@networklearning.local>

# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# Base URL for links in outbound email. Must be the address the *browser*
# reaches, not the API's own origin.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Single-use token lifetimes
# ---------------------------------------------------------------------------
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# In-process and per-worker; see app/core/rate_limit.py. Part 10 moves the
# backing store to Redis so the limits become global.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_EMAIL_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_15_MIN=10
